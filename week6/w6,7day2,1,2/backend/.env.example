# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and fill in real values.
# In production (Railway, Render, Fly.io etc.), set these as platform env vars.
# NEVER commit your real .env to git!

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ecommerce?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=7d

# ── Session (Required for OAuth CSRF protection) ──────────────────────────────
SESSION_SECRET=your_super_secret_session_key_change_in_production

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================================================================
# FRONTEND URL  <-- THE MOST IMPORTANT VALUE FOR PRODUCTION!
# ==============================================================================
# This single variable controls TWO things:
#   1. CORS allowed origin in main.ts
#   2. The URL users are redirected to after OAuth login
#
# Development:
FRONTEND_URL=http://localhost:3000
# Production example:
# FRONTEND_URL=https://your-app.vercel.app

# ==============================================================================
# OAuth 2.0 Providers
# ==============================================================================
# IMPORTANT: When deploying, update ALL three callback URLs below to use your
# production backend domain AND register them in each provider's developer console.

# ── Google (console.cloud.google.com -> APIs & Services -> Credentials) ───────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Dev:
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
# Production example:
# GOOGLE_CALLBACK_URL=https://your-api.railway.app/auth/google/callback

# ── GitHub (github.com -> Settings -> Developer settings -> OAuth Apps) ────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Dev:
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback
# Production example:
# GITHUB_CALLBACK_URL=https://your-api.railway.app/auth/github/callback

# ── Discord (discord.com/developers/applications -> OAuth2) ──────────────────
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# Dev:
DISCORD_CALLBACK_URL=http://localhost:4000/auth/discord/callback
# Production example:
# DISCORD_CALLBACK_URL=https://your-api.railway.app/auth/discord/callback

# ==============================================================================
# Stripe Payments (dashboard.stripe.com -> API Keys & Webhooks)
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Note: For webhooks, the URL you register in Stripe should be:
# https://your-backend-url.onrender.com/stripe/webhook

